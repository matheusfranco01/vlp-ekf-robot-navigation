<launch>
  <!-- Simulation Parameters Declaration -->
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>

  <!-- Dynamic Package Path Resolution -->
  <arg name="world_path" value="$(find my_worlds)/worlds/tube_world.world"/>
  <!-- <arg name="world_path" value="$(find my_worlds)/worlds/bulb_world.world"/> -->
  
  <!-- Set Gazebo Model Path for Custom Models -->
  <env name="GAZEBO_MODEL_PATH" value="$(find my_worlds)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- Gazebo Server -->
  <node name="gazebo" pkg="gazebo_ros" type="gzserver" args="$(arg world_path)" respawn="false" output="screen">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- Gazebo GUI Client (if not headless) -->
  <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient" respawn="false" output="screen" if="$(arg gui)"/>
</launch>
